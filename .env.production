# ─────────────────────────────────────────────────────────────────────────────
# MoneyPuran – PRODUCTION (Hostinger)
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL (Hostinger) ─────────────────────────────────────────────────────────
# Note: & and # in password are URL-encoded (%26 and %23)
DATABASE_URL="mysql://u286969112_moneypuran:K%26Z2ohN%237JUnnLCo@localhost:3306/u286969112_moneypuran_db"

# ── Redis ─────────────────────────────────────────────────────────────────────
# Hostinger doesn't include Redis — use Upstash free tier:
# https://upstash.com → Create Redis → Copy "REDIS_URL"
REDIS_URL="redis://default:CHANGE_ME@your-instance.upstash.io:6379"

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET="moneypuran-prod-jwt-secret-please-change-this-to-random-string-48"
JWT_REFRESH_SECRET="moneypuran-prod-refresh-secret-change-this-to-random-48-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://moneypuran.com"
NODE_ENV="production"

# ── OpenAI (add your key when ready) ─────────────────────────────────────────
OPENAI_API_KEY="sk-CHANGE_ME_your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"

# ── Google (add when ready) ───────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_ADSENSE_ID=""

# ── Seed (first deploy only) ──────────────────────────────────────────────────
ADMIN_EMAIL="admin@moneypuran.com"
ADMIN_PASSWORD="Admin@123"
