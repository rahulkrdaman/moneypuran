# Database
DATABASE_URL="postgresql://moneypuran:password@localhost:5432/moneypuran_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MoneyPuran"
NEXT_PUBLIC_APP_DESCRIPTION="Finance & Business News"
NODE_ENV="development"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="MoneyPuran <noreply@moneypuran.com>"

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="10485760"  # 10MB

# Google
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_ADSENSE_ID=""
NEXT_PUBLIC_GTM_ID=""

# CDN (optional)
CDN_URL=""

# Admin
ADMIN_EMAIL="admin@moneypuran.com"
ADMIN_PASSWORD="SecurePass123!"
