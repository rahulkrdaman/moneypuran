# Database
DATABASE_URL="postgresql://moneypuran:password@localhost:5432/moneypuran_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MoneyPuran"
NEXT_PUBLIC_APP_DESCRIPTION="Finance & Business News"
NODE_ENV="development"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="MoneyPuran <noreply@moneypuran.com>"

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="10485760"  # 10MB

# Google
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_ADSENSE_ID=""
NEXT_PUBLIC_GTM_ID=""

# CDN (optional)
CDN_URL=""

# Admin
ADMIN_EMAIL="admin@moneypuran.com"
ADMIN_PASSWORD="SecurePass123!"

# ─────────────────────────────────────────────────────────────────────────────
#  MARKET DATA  (platform branch)
# ─────────────────────────────────────────────────────────────────────────────
# Set MARKET_DATA_MOCK=true for dev/CI/demo: deterministic fake data, no keys,
# no licence. Every value is labelled "Demo data" in the UI.
MARKET_DATA_MOCK="true"

# When MOCK is false, pick the primary provider and supply its key.
MARKET_DATA_PROVIDER="twelvedata"          # twelvedata | coingecko | alphavantage

# Twelve Data — https://twelvedata.com  (primary: stocks/etf/index/fx/commodities)
TWELVE_DATA_API_KEY=""
TWELVE_DATA_PLAN="free"                    # free | basic | grow | pro | enterprise
# MUST be "true" to serve Twelve Data to the PUBLIC. Free/Basic/Grow plans do NOT
# license commercial public display — keep this false until you buy a plan that does.
TWELVE_DATA_EXTERNAL_DISPLAY_LICENSE="false"

# CoinGecko — https://coingecko.com  (preferred for crypto). Keyless works at low
# volume for dev; a Demo/Pro key is required for commercial use.
COINGECKO_API_KEY=""

# Alpha Vantage — https://alphavantage.co  (FALLBACK ONLY; free tier is 25 req/day
# and non-commercial — treated as dev-only, never served to the public in prod).
ALPHAVANTAGE_API_KEY=""

# Optional cache TTL overrides (seconds) — sensible defaults in src/lib/market/config.ts
# MARKET_TTL_CRYPTO="20"
# MARKET_TTL_STOCK="20"
# MARKET_TTL_INDEX="45"
