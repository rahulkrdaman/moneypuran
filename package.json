{
  "name": "moneypuran",
  "version": "1.0.0",
  "description": "MoneyPuran - Modern Finance & Business News Platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node --skip-project prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker:start": "ts-node --skip-project src/workers/ai-worker.ts",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:market": "tsx src/workers/market-worker.cli.ts",
    "worker:market:once": "tsx src/workers/market-worker.cli.ts --once"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@prisma/client": "^6.0.0",
    "typescript": "^5.7.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.10.0",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "jsonwebtoken": "^9.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "bcryptjs": "^2.4.3",
    "@types/bcryptjs": "^2.4.6",
    "openai": "^4.77.0",
    "ioredis": "^5.4.1",
    "bull": "^4.16.3",
    "rss-parser": "^3.13.0",
    "zod": "^3.24.1",
    "sanitize-html": "^2.14.0",
    "@types/sanitize-html": "^2.13.0",
    "lucide-react": "^0.441.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "next-themes": "^0.4.4",
    "recharts": "^2.15.4",
    "cron": "^3.1.7",
    "@tailwindcss/typography": "^0.5.15"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.3.0",
    "@typescript-eslint/parser": "^8.18.0",
    "ts-node": "^10.9.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  }
}
